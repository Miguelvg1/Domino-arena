<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://titanesdomino.app/tv"
        version="0.1.0"
        viewmodes="fullscreen">
  <name>Titanes Dominó TV</name>
  <description>Marcadores de torneos de dominó para televisión</description>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <tizen:application id="TITANESTV.TitanesTV"
                     package="TITANESTV"
                     required_version="5.5"/>
  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape"
                 context-menu="enable"
                 background-support="disable"
                 encryption="disable"
                 install-location="auto"
                 hwkey-event="enable"
                 pointing-device-support="disable"/>
</widget>
